VERSION="0.4.4"

print_version() {
    local opencode_version
    opencode_version="$(opencode --version)"
    # opencode v1 prints a bare version; v2 prints "opencode v<version>".
    echo "opencode v${opencode_version#opencode v}"
    echo "opencodebox v$VERSION"
    exit 0
}

print_help() {
    cat <<EOF
opencodebox - Run OpenCode inside bubblewrap sandbox

Usage:
  opencodebox [OPTIONS] [OPENCODE_ARGS...]

Options:
  --with /host[:/sandbox]      Bind host path read-write (sandbox path defaults to host path)
  --with-ro /host[:/sandbox]   Bind host path read-only (sandbox path defaults to host path)
  --device /dev/NAME          Expose a host device node with the same mode as on the host
  --version, -v                Show version information
  --help, -h                   Show this help message

Isolation:
  OpenCode 2 always runs fully isolated: every command gets a private
  server inside the sandbox. 'pair', 'service', 'serve --service',
  'serve --stdio', '--server', 'upgrade', 'update' and 'uninstall' are
  refused; the error message explains why and, where there is one,
  names the alternative (web UI: 'opencodebox serve --port N', then open
  the printed URL in the host browser).

Examples:
  opencodebox --with ../app-backend
  opencodebox --with /mnt/data:/workspace/data
  opencodebox --with-ro /etc/hosts
  opencodebox --device /dev/ttyUSB0 --device /dev/video0
  opencodebox --with ~/another-project1 --with-ro ~/another-project2 serve
EOF
    exit 0
}

# Helper to check if a path is sensitive (or an ancestor of one)
is_sensitive_path() {
    local path="$1"
    [[ "$path" == "$HOME/.ssh" || "$path" == "$HOME/.ssh/"* || \
       "$path" == "$HOME/.gnupg" || "$path" == "$HOME/.gnupg/"* || \
       "$path" == "$HOME" || "$HOME" == "$path"/* || "$path" == "/" ]]
}

# Helper to refuse a dangling symlink at an overlay destination: bwrap would
# abort with a cryptic error, and the symlink must not be written through
check_overlay_destination() {
    local path="$1"

    if [[ -L "$path" && ! -e "$path" ]]; then
        echo "Error: '$path' is a dangling symlink; remove it before running opencodebox." >&2
        exit 1
    fi
}

# Helper to write a generated file without following a symlink at the
# destination: the content goes to a fresh temp file that is moved into place
write_generated_file() {
    local path="$1"
    local format="$2"
    local tmp

    tmp="$(mktemp "$(dirname "$path")/.opencodebox.XXXXXX")" || return 1
    if ! printf "$format" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    mv -f "$tmp" "$path"
}

# Prerequisite checks - fail fast with helpful messages
check_prerequisites() {
    local missing=0

    # Check for bwrap (bubblewrap)
    if ! command -v bwrap >/dev/null 2>&1; then
        echo "Error: bubblewrap (bwrap) is not installed." >&2
        echo "" >&2
        echo "Install bubblewrap:" >&2
        echo "  Arch: sudo pacman -S bubblewrap" >&2
        echo "  Ubuntu/Debian: sudo apt install bubblewrap" >&2
        echo "  Fedora: sudo dnf install bubblewrap" >&2
        missing=1
    fi

    # Check for opencode
    if ! command -v opencode >/dev/null 2>&1; then
        echo "Error: opencode is not installed or not in PATH." >&2
        echo "" >&2
        echo "Install opencode:" >&2
        echo "  Using mise: mise use -g opencode" >&2
        echo "  Or download from: https://opencode.ai" >&2
        missing=1
    fi

    if [[ $missing -eq 1 ]]; then
        exit 1
    fi
}

sanitize_ssh_public_key_file() {
    local file="$1"
    local key_fd line extra key_type key_data rest

    command -v ssh-keygen >/dev/null 2>&1 || return 1

    # Open file first to avoid TOCTOU between check and open
    exec {key_fd}<"$file" || return 1

    # Validate the opened FD (not the path) to prevent TOCTOU
    if [[ $(stat -L -c '%F' /proc/self/fd/$key_fd 2>/dev/null) != "regular file" ]]; then
        exec {key_fd}<&-
        return 1
    fi
    if [[ $(stat -L -c '%h' /proc/self/fd/$key_fd 2>/dev/null) -ne 1 ]]; then
        exec {key_fd}<&-
        return 1
    fi

    IFS= read -r line <&"$key_fd" || {
        exec {key_fd}<&-
        return 1
    }
    if IFS= read -r extra <&"$key_fd"; then
        exec {key_fd}<&-
        return 1
    fi

    read -r key_type key_data rest <<< "$line"
    # Accept optional comment in rest; only emit sanitized key_type + key_data
    [[ -n "$key_data" && "$key_data" =~ ^[A-Za-z0-9+/]+={0,2}$ ]] || {
        exec {key_fd}<&-
        return 1
    }

    case "$key_type" in
        ssh-ed25519|ssh-ed25519-cert-v01@openssh.com|ssh-rsa|ssh-rsa-cert-v01@openssh.com|rsa-sha2-256|rsa-sha2-256-cert-v01@openssh.com|rsa-sha2-512|rsa-sha2-512-cert-v01@openssh.com|ecdsa-sha2-nistp256|ecdsa-sha2-nistp256-cert-v01@openssh.com|ecdsa-sha2-nistp384|ecdsa-sha2-nistp384-cert-v01@openssh.com|ecdsa-sha2-nistp521|ecdsa-sha2-nistp521-cert-v01@openssh.com|sk-ssh-ed25519@openssh.com|sk-ssh-ed25519-cert-v01@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com|sk-ecdsa-sha2-nistp256-cert-v01@openssh.com)
            # Validate sanitized key with ssh-keygen; uses process substitution as file input
            ssh-keygen -l -f <(printf '%s %s\n' "$key_type" "$key_data") >/dev/null 2>&1 || {
                exec {key_fd}<&-
                return 1
            }
            exec {key_fd}<&-
            printf '%s %s\n' "$key_type" "$key_data"
            ;;
        *)
            exec {key_fd}<&-
            return 1
            ;;
    esac
}

# BEGIN DEVICE MOUNTS
# Internal root argument allows fixture testing without real device nodes.
# The launcher always calls this with the host's /dev. --dev-bind shares the
# host inode, so the bound node keeps its host mode, owner, group, and ACLs:
# device access inside the sandbox matches the host.

# Advisory only: the sandbox inherits host device access exactly (same inode,
# same uid/gid and supplementary groups), so a node whose mode bits deny the
# invoking user both read and write cannot be opened inside either. Warn with
# the usual host-side fix instead of failing silently at open() time. Nodes
# with POSIX ACLs (stat '%A' ends in '+') are skipped: their access is not
# described by the mode bits. The node is never opened. Launcher identity
# variables are required; when absent (extracted helper tests) this is skipped.
warn_if_device_inaccessible() {
    local path="$1" mode node_uid node_gid perms mode_bits class group_label
    [[ -n "${USER_ID:-}" && -n "${USER_NAME:-}" ]] || return 0

    read -r mode node_uid node_gid perms \
        < <(LC_ALL=C stat -c '%a %u %g %A' "$path" 2>/dev/null) || return 0
    # stat %a prints octal without leading zeros ("0" for mode 000).
    [[ "$mode" =~ ^[0-7]{1,4}$ ]] || return 0
    # POSIX ACLs may grant access beyond the mode bits.
    [[ "$perms" != *"+"* ]] || return 0

    # Permission class that applies to the invoking user.
    mode_bits=$(( 8#$mode & 8#777 ))
    if [[ "$node_uid" == "$USER_ID" ]]; then
        class=$(( (mode_bits >> 6) & 7 ))
    elif [[ " ${USER_GROUPS:-} " == *" $node_gid "* ]]; then
        class=$(( (mode_bits >> 3) & 7 ))
    else
        class=$(( mode_bits & 7 ))
    fi
    # Warn only when neither read (4) nor write (2) is possible.
    [[ $(( class & 6 )) -eq 0 ]] || return 0

    if [[ "$node_uid" == "$USER_ID" ]]; then
        echo "Warning: --device '$path' is owned by user '$USER_NAME' but its mode ($mode) grants no read or write. Programs inside the sandbox inherit host access and cannot open it. Fix the node's permissions on the host (for example with a udev rule) and relaunch." >&2
        return 0
    fi

    group_line=""
    read -r group_line < <(getent group "$node_gid" 2>/dev/null)
    group_label="${group_line%%:*}"
    [[ -n "$group_label" ]] || group_label="$node_gid"
    echo "Warning: --device '$path' is owned by uid $node_uid, group $group_label (mode $mode) and user '$USER_NAME' has no read or write access to it on the host. Programs inside the sandbox inherit host access and cannot open it. Fix host access on the host (e.g. 'sudo usermod -aG $group_label $USER_NAME', then log out and back in) and relaunch." >&2
}

configure_device_mounts() {
    local dev_root="${1:-/dev}"
    shift
    local path relative component sub kind
    local -a mounts=() components=()
    local -A seen_paths=()
    local -A seen_dirs=()

    for path in "$@"; do
        # Devices live under the host /dev; bind them at the same sandbox path.
        if [[ "$path" != "$dev_root"/* ]]; then
            echo "Error: --device requires an absolute path under $dev_root (got '$path')." >&2
            return 1
        fi
        relative="${path#"$dev_root"/}"
        [[ -z "${seen_paths[$relative]:-}" ]] || continue

        # Refuse empty, '.', '..', and '//' path components.
        IFS='/' read -ra components <<< "$relative"
        for component in "${components[@]}"; do
            if [[ -z "$component" || "$component" == "." || "$component" == ".." ]]; then
                echo "Error: --device refuses unsafe path '$path'." >&2
                return 1
            fi
        done

        # stat without -L does not follow symlinks. Fix locale for its type text.
        if [[ -L "$path" ]]; then
            echo "Error: --device refuses symlink '$path'; pass the resolved device node instead." >&2
            return 1
        fi
        kind="$(LC_ALL=C stat -c '%F' "$path" 2>/dev/null)" || kind=""
        if [[ "$kind" != "character special file" && "$kind" != "block special file" ]]; then
            echo "Error: --device '$path' is not a character or block device node (stat reports: '${kind:-inaccessible}')." >&2
            return 1
        fi
        seen_paths[$relative]=1

        # Advisory only: the bind below still happens.
        warn_if_device_inaccessible "$path"

        # bwrap --dir does not auto-create parents; add each ancestor under /dev.
        if [[ ${#components[@]} -gt 1 ]]; then
            sub=""
            for component in "${components[@]:0:${#components[@]}-1}"; do
                sub+="/$component"
                if [[ -z "${seen_dirs[$sub]:-}" ]]; then
                    if [[ -L "$dev_root/$sub" ]]; then
                        echo "Error: --device refuses symlinked device directory '$dev_root/$sub'." >&2
                        return 1
                    fi
                    seen_dirs[$sub]=1
                    mounts+=(--dir "/dev$sub")
                fi
            done
        fi
        mounts+=(--dev-bind "$path" "/dev/$relative")
    done

    if [[ ${#mounts[@]} -eq 0 ]]; then
        return 0
    fi
    BWRAP_ARGS+=("${mounts[@]}")
    echo "Warning: --device exposes host device nodes to the sandbox; each node keeps its host mode and permissions." >&2
}
# END DEVICE MOUNTS

# Parse --with and --with-ro arguments
# These allow users to bind additional paths into the sandbox
declare -a EXTRA_BINDS=()
declare -a REMAINING_ARGS=()
declare -a DEVICE_PATHS=()

add_readonly_regular_file() {
    local file="$1"
    local fd

    # Open first to avoid TOCTOU if file is swapped with symlink after check
    # Use 2>/dev/null to suppress error if file doesn't exist, we handle it below
    if ! { exec {fd}<"$file"; } 2>/dev/null; then
        echo "Warning: Cannot open '$file'. Skipping." >&2
        return 1
    fi

    # Validate the actual file opened by FD, not the path (eliminates TOCTOU)
    if [[ $(stat -L -c '%F' /proc/self/fd/$fd 2>/dev/null) != "regular file" ]]; then
        echo "Warning: '$file' is not a regular file. Skipping." >&2
        exec {fd}<&-
        return 1
    fi
    if [[ $(stat -L -c '%h' /proc/self/fd/$fd 2>/dev/null) -ne 1 ]]; then
        echo "Warning: '$file' has multiple hardlinks. Skipping." >&2
        exec {fd}<&-
        return 1
    fi

    # To prevent TOCTOU attacks where the file is replaced with a symlink
    # between our checks and bwrap execution, we open it now and pass the FD
    BWRAP_ARGS+=(--file "$fd" "$file")
}

parse_bind_arg() {
    local bind_type="$1"
    local val="$2"
    local host sandbox

    if [[ "$val" == *:* ]]; then
        # Format: /host:/sandbox
        host="${val%%:*}"
        sandbox="${val##*:}"
    else
        # Format: /path (same path in sandbox)
        host="$(realpath -e "$val" 2>/dev/null)" || {
            echo "Error: $bind_type path does not exist: $val" >&2
            exit 1
        }
        sandbox="$host"
    fi

    # Reject sensitive paths and their ancestors
    if is_sensitive_path "$host"; then
        echo "Error: Cannot bind sensitive directory '$host' or its ancestor into sandbox." >&2
        exit 1
    fi

    EXTRA_BINDS+=("$bind_type" "$host" "$sandbox")
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            print_help
            ;;
        --version|-v)
            print_version
            ;;
        # --with: read-write bind (allows modification inside sandbox)
        --with)
            shift
            if [[ $# -eq 0 ]]; then
                echo "Error: --with requires a value" >&2
                echo "Usage: opencodebox --with /host/path or --with /host:/sandbox" >&2
                exit 1
            fi
            parse_bind_arg "--bind" "$1"
            shift
            ;;
        # --with-ro: read-only bind (sandbox cannot modify)
        --with-ro)
            shift
            if [[ $# -eq 0 ]]; then
                echo "Error: --with-ro requires a value" >&2
                echo "Usage: opencodebox --with-ro /host/path or --with-ro /host:/sandbox" >&2
                exit 1
            fi
            parse_bind_arg "--ro-bind" "$1"
            shift
            ;;
        # --device: expose one host device node (repeat for multiple nodes)
        --device)
            shift
            if [[ $# -eq 0 ]]; then
                echo "Error: --device requires a value" >&2
                echo "Usage: opencodebox --device /dev/ttyUSB0" >&2
                exit 1
            fi
            # Device paths are absolute under /dev, so a dash can only be a typo.
            if [[ "$1" == -* ]]; then
                echo "Error: --device requires a device path, not another option (got '$1')." >&2
                echo "Usage: opencodebox --device /dev/ttyUSB0" >&2
                exit 1
            fi
            DEVICE_PATHS+=("$1")
            shift
            ;;
        # Pass through all other args to opencode
        *)
            REMAINING_ARGS+=("$1")
            shift
            ;;
    esac
done

check_prerequisites

# Seccomp BPF filter loading
SECCOMP_FD=""
SECCOMP_FILE="$HOME/.local/share/opencodebox/seccomp-security.bpf"

# Detect and map architecture
ARCH=$(uname -m)
case "$ARCH" in
    x86_64)
        SECCOMP_ARCH="x86_64"
        ;;
    aarch64|arm64)
        SECCOMP_ARCH="aarch64"
        ;;
    *)
        SECCOMP_ARCH="unsupported"
        ;;
esac

# Load seccomp filter if arch is supported and file exists
if [[ "$SECCOMP_ARCH" != "unsupported" ]]; then
    # Open file atomically to avoid TOCTOU race condition
    if ! { exec {SECCOMP_FD}< "$SECCOMP_FILE"; } 2>/dev/null; then
        if [[ ! -e "$SECCOMP_FILE" ]]; then
            echo "Warning: Seccomp BPF sandbox filter not found at $SECCOMP_FILE. Continuing without seccomp mitigations." >&2
        else
            echo "Warning: Failed to open seccomp BPF sandbox filter at $SECCOMP_FILE. Continuing without seccomp mitigations." >&2
        fi
        SECCOMP_FD=""
    fi
else
    echo "Warning: Unsupported architecture $ARCH for seccomp sandbox filter. Continuing without seccomp mitigations." >&2
fi

PROJECT_DIR="$PWD"

# Provide minimal NSS identity inside sandbox. Some tools (Git SSH signing,
# ssh-keygen) call getpwuid() and fail if current UID has no /etc/passwd entry.
# FDs intentionally not closed; bwrap reads from them via --file
USER_ID="$(id -u)"
GROUP_ID="$(id -g)"
USER_NAME="$(id -un)"
GROUP_NAME="$(id -gn)"
# All group IDs the user belongs to (primary first). bwrap's user namespace
# maps only the user's own uid/gid, so `id` inside the sandbox prints
# supplementary groups as 65534 even though the kernel still enforces the
# real host groups on every bound inode (devices included). Writing the host
# groups into /etc/group keeps name-based lookups (getent, ls -l,
# initgroups) consistent inside the sandbox.
USER_GROUPS="$(id -G 2>/dev/null)"
GROUP_ENTRIES=""
for group_id in $USER_GROUPS; do
    group_line=""
    read -r group_line < <(getent group "$group_id" 2>/dev/null)
    group_name="${group_line%%:*}"
    [[ -n "$group_name" ]] || group_name="$group_id"
    GROUP_ENTRIES+="$(printf '%s:x:%s:%s' "$group_name" "$group_id" "$USER_NAME")"$'\n'
done
# Fallback to the primary group only (pre-existing behavior).
[[ -n "$GROUP_ENTRIES" ]] || GROUP_ENTRIES="$(printf '%s:x:%s:' "$GROUP_NAME" "$GROUP_ID")"$'\n'
# 'root' and 'nobody' (the kernel overflow id, 65534) resolve for name
# lookups. Ids that are not mapped into the sandbox's user namespace — for
# example root/dialout on a bound device node — always render as
# 65534/'nobody' inside; that display artifact does not change access.
exec {PASSWD_FD}< <(printf 'root:x:0:0:root:/root:/sbin/nologin\nnobody:x:65534:65534:Kernel Overflow User:/:/sbin/nologin\n%s:x:%s:%s:%s:%s:/bin/bash\n' \
    "$USER_NAME" "$USER_ID" "$GROUP_ID" "$USER_NAME" "$HOME")
exec {GROUP_FD}< <(printf 'root:x:0:\nnobody:x:65534:\n%s' "$GROUP_ENTRIES")

# Restore remaining args for opencode
set -- "${REMAINING_ARGS[@]}"
# OpenCode v2 isolation: the server must always run inside the sandbox.
# Refuse commands that would attach to, manage, or register a host service.
_iso_subcommand=""
_iso_skip_next=0
_iso_serve_service=0
_iso_serve_stdio=0
for _iso_tok in "$@"; do
    if [[ $_iso_skip_next -eq 1 ]]; then _iso_skip_next=0; continue; fi
    case "$_iso_tok" in
        --) break ;;
        --server|--server=*)
            echo "Error: '--server' cannot run in isolation: it connects to a server outside the sandbox. Run the command with 'opencode' on the host instead." >&2
            exit 1 ;;
        --session|--prompt|-s) _iso_skip_next=1 ;;
        --service|--service=*) _iso_serve_service=1 ;;
        --stdio|--stdio=*) _iso_serve_stdio=1 ;;
        -*) ;;
        *)
            if [[ -z "$_iso_subcommand" ]]; then
                case "$_iso_tok" in
                    upgrade|update|uninstall|acp|api|debug|auth|mcp|plugin|models|stats|mini|run|session|service|reload|pair|serve)
                        _iso_subcommand="$_iso_tok" ;;
                esac
            fi ;;
    esac
done
unset _iso_tok
case "$_iso_subcommand" in
    pair)
        echo "Error: 'pair' cannot run in isolation: it requires the background service. Use 'opencodebox serve --port N' and open the printed URL in your browser instead." >&2
        exit 1 ;;
    service)
        echo "Error: 'service' cannot run in isolation: it manages the host background service. Run 'opencode service ...' on the host instead." >&2
        exit 1 ;;
    upgrade|update|uninstall)
        echo "Error: '$_iso_subcommand' cannot run in isolation: it modifies the host installation. Run 'opencode $_iso_subcommand' on the host instead." >&2
        exit 1 ;;
    serve)
        if [[ $_iso_serve_service -eq 1 ]]; then
            echo "Error: 'serve --service' cannot run in isolation: it registers a background service that would die with the sandbox. Drop '--service' to run the server in the foreground." >&2
            exit 1
        fi
        if [[ $_iso_serve_stdio -eq 1 ]]; then
            echo "Error: 'serve --stdio' cannot run in isolation: it is an internal server mode. Drop '--stdio' to run the server in the foreground." >&2
            exit 1
        fi ;;
esac
unset _iso_subcommand _iso_skip_next _iso_serve_service _iso_serve_stdio

# Prevent running from sensitive directories (but not for --help/--version which already exited)
if is_sensitive_path "$PROJECT_DIR"; then
    echo "Error: Cannot run from $HOME, sensitive directories, or their ancestors as it bypasses sandbox isolation." >&2
    echo "Please cd into a specific project directory before running." >&2
    exit 1
fi

# Define paths for persistent data storage
APP_DATA="$HOME/.local/share/opencode"
if [[ -n "${OPENCODE_CONFIG_DIR:-}" ]]; then
    CONFIG_DIR="$OPENCODE_CONFIG_DIR"
elif [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    CONFIG_DIR="$XDG_CONFIG_HOME/opencode"
else
    CONFIG_DIR="$HOME/.config/opencode"
fi
CONFIG_DIR="$(realpath -ms "$CONFIG_DIR")"
# The lexical path is what gets mounted (the CLI resolves the same way), but a
# symlink could still point at a sensitive location. Check the resolved path
# too and refuse when either one is sensitive.
CONFIG_DIR_RESOLVED="$(realpath -m "$CONFIG_DIR" 2>/dev/null || printf '%s' "$CONFIG_DIR")"
if is_sensitive_path "$CONFIG_DIR" || is_sensitive_path "$CONFIG_DIR_RESOLVED"; then
    echo "Error: service config directory '$CONFIG_DIR' points to or encloses a sensitive location." >&2
    exit 1
fi
AGENTS_DIR="$HOME/.agents"
CACHE_DIR="$HOME/.cache/opencode"

# Locate the opencode launcher. npm-style installs (mise/aube, npm, pnpm, bun)
# put a shim in a node_modules/.bin directory that execs its target through a
# path relative to itself (e.g. "$basedir/../.mise/@opencode+cli@<ver>/...").
# The shim's parent directory must therefore stay visible next to it.
OPCODE_PATH=$(command -v opencode)
# Lexical normalisation only (symlinks stay unresolved): PATH entries with "."
# or ".." must not change what gets mounted or slip past the guard below.
OPCODE_DIR="$(realpath -ms "$OPCODE_PATH" 2>/dev/null || printf '%s' "$OPCODE_PATH")"
OPCODE_DIR="${OPCODE_DIR%/*}"
OPCODE_PARENT="${OPCODE_DIR%/*}"
OPCODE_BIND_FLAG="--bind"
OPCODE_ROOT="$OPCODE_DIR"
OPCODE_LAUNCHER="${OPCODE_PATH##*/}"
if [[ "${OPCODE_DIR##*/}" == ".bin" ]]; then
    if [[ "${OPCODE_PARENT##*/}" == "node_modules" ]] && ! is_sensitive_path "$OPCODE_PARENT"; then
        OPCODE_BIND_FLAG="--ro-bind"
        OPCODE_ROOT="$OPCODE_PARENT"
        OPCODE_LAUNCHER="${OPCODE_DIR##*/}/${OPCODE_PATH##*/}"
    else
        echo "Warning: $OPCODE_PATH looks like an npm-style shim, but ${OPCODE_PARENT} is not mounted (not node_modules, or sensitive). Unless the shim is self-contained, it will fail with 'not found' (exit 127)." >&2
    fi
fi
OPCODE_SANDBOX_PATH="/opt/opencode/$OPCODE_LAUNCHER"

# bwrap --bind hard-fails if the source is missing; opencode v2 keeps state under
# ~/.local/state/opencode, which v1 users and fresh hosts may not have created yet.
STATE_DIR="$HOME/.local/state/opencode"
mkdir -p "$STATE_DIR"

# The overlay binds replace these paths inside the sandbox; a dangling
# symlink there would make bwrap abort, so refuse it up front.
check_overlay_destination "$CONFIG_DIR/service.json"
check_overlay_destination "$CONFIG_DIR/service-local.json"
check_overlay_destination "$CONFIG_DIR/service-prod.json"
check_overlay_destination "$STATE_DIR/service.json"
# The remaining masked destinations are picked up by glob below.
shopt -s nullglob
for _iso_masked in "$CONFIG_DIR"/service-*.json "$STATE_DIR"/service*.json; do
    check_overlay_destination "$_iso_masked"
done
shopt -u nullglob
unset _iso_masked

# A fresh host has none of opencode's directories: bwrap --ro-bind/--bind fails
# on missing sources, and opencode (v1 and v2) mkdirs ~/.cache/opencode/bin at
# startup even though the cache tree is mounted read-only.
mkdir -p "$CONFIG_DIR" "$AGENTS_DIR" "$CACHE_DIR/bin" "$APP_DATA"
for _iso_seed in service.json service-local.json service-prod.json; do
    # A dangling symlink must not be written through: it could create the file
    # outside the config dir.
    if [[ ! -e "$CONFIG_DIR/$_iso_seed" && ! -L "$CONFIG_DIR/$_iso_seed" ]]; then
        printf '{}\n' > "$CONFIG_DIR/$_iso_seed"
    fi
done
unset _iso_seed

# The host service registration in the state dir is masked with a ro-bind below.
# bwrap creates a missing bind destination as an empty read-only file, which
# would leave the host without a usable registration, so seed it up front.
if [[ ! -e "$STATE_DIR/service.json" && ! -L "$STATE_DIR/service.json" ]]; then
    printf '{}\n' > "$STATE_DIR/service.json"
fi

# Later bindings override earlier ones (the isolation overlay is appended last)
declare -a BWRAP_ARGS=(
    # --- Isolation & Namespaces ---
    # Unshare PID/IPC/UTS namespaces for process isolation
    --unshare-pid
    --unshare-ipc
    --unshare-uts
    --die-with-parent    # Sandbox dies if parent process dies

    # --- Core System Resources ---
    --dev /dev           # Device nodes (null, zero, random, etc.)
    --proc /proc         # Process information filesystem
    --tmpfs /tmp         # Private temp directory

    # --- Read-Only System Root ---
    # Bind entire /usr read-only, symlink standard directories
    --ro-bind /usr /usr
    --symlink usr/lib64 /lib64
    --symlink usr/bin /bin
    --symlink usr/lib /lib

    # --- Sandbox Identity ---
    --hostname opencodebox

    # --- Hostname Resolution ---
    # Keep explicit destinations: resolv.conf may be a symlink on the host.
    --ro-bind /etc/resolv.conf /etc/resolv.conf
    --ro-bind /etc/hosts /etc/hosts
    --ro-bind-try /etc/nsswitch.conf /etc/nsswitch.conf

    # --- SSL/TLS Certificates ---
    # Certificate layouts differ by distribution. Fedora's /etc/ssl links
    # into /etc/pki; expose its trust store without mounting tls/private.
    --ro-bind-try /etc/ssl /etc/ssl
    --ro-bind-try /etc/ca-certificates /etc/ca-certificates
    --ro-bind-try /etc/pki/ca-trust /etc/pki/ca-trust
    --ro-bind-try /etc/pki/tls/certs /etc/pki/tls/certs

    # --- Alternatives (managed by update-alternatives) ---
    --ro-bind /etc/alternatives /etc/alternatives

    # --- Minimal User Identity ---
    --file "$PASSWD_FD" /etc/passwd
    --file "$GROUP_FD" /etc/group

    # --- User Local Data ---
    --ro-bind "$HOME/.local" "$HOME/.local"
    --tmpfs "$HOME/.cache"                   # Writable cache (universal for uv, cargo, etc.)
    --bind "$STATE_DIR" "$STATE_DIR" # Writable state (locks, etc.)

    # --- OpenCode Specific (read-only) ---
    --ro-bind "$CONFIG_DIR" "$CONFIG_DIR"
    --ro-bind "$AGENTS_DIR" "$AGENTS_DIR"
    --ro-bind "$CACHE_DIR" "$CACHE_DIR"

    # --- Read-Write Bindings ---
    --bind "$PROJECT_DIR" "$PROJECT_DIR"    # Current project (read-write)
    --bind "$APP_DATA" "$APP_DATA"          # OpenCode data (read-write)

    # --- OpenCode Binary ---
    "$OPCODE_BIND_FLAG" "$OPCODE_ROOT" /opt/opencode
)

# Explicitly requested device nodes follow the private /dev; explicit user
# binds and the isolation overlay are appended later and still override them.
if [[ ${#DEVICE_PATHS[@]} -gt 0 ]]; then
    configure_device_mounts /dev "${DEVICE_PATHS[@]}" || exit 1
fi

# Private keyring (unmount if present)
[[ -d "$HOME/.local/share/keyrings" ]] && BWRAP_ARGS+=(--tmpfs "$HOME/.local/share/keyrings")

# Add seccomp filter to bwrap arguments if available
if [[ -n "$SECCOMP_FD" ]]; then
    BWRAP_ARGS+=(--seccomp "$SECCOMP_FD")
fi

# Reject if .ssh directory has permissive permissions (should be 0700)
# This prevents TOCTOU attacks where .pub files are modified during validation
if [[ -d "$HOME/.ssh" && ! -L "$HOME/.ssh" ]]; then
    if [[ $(stat -c '%a' "$HOME/.ssh" 2>/dev/null) != "700" ]]; then
        echo "Error: $HOME/.ssh permissions must be 0700 to ensure sandbox security." >&2
        echo "Please run: chmod 700 $HOME/.ssh" >&2
        exit 1
    fi
fi

# Git SSH signing often uses user.signingkey=~/.ssh/*.pub. Expose only
# sanitized OpenSSH public key material, not file comments or extra data.
SSH_DOT_DIR_CREATED=0
if [[ -d "$HOME/.ssh" && ! -L "$HOME/.ssh" ]]; then
    BWRAP_ARGS+=(--dir "$HOME/.ssh")
    SSH_DOT_DIR_CREATED=1

    add_readonly_regular_file "$HOME/.ssh/known_hosts"

    shopt -s nullglob
    for pubkey in "$HOME"/.ssh/*.pub; do
        public_key_line="$(sanitize_ssh_public_key_file "$pubkey")" || continue
        exec {pubkey_fd}< <(printf '%s\n' "$public_key_line")
        # FDs intentionally not closed; bwrap reads from them via --file
        BWRAP_ARGS+=(--file "$pubkey_fd" "$pubkey")
    done
    shopt -u nullglob
fi

ALLOWED_SIGNERS_FILE="$(git config --path --get gpg.ssh.allowedSignersFile 2>/dev/null || true)"
if [[ -n "$ALLOWED_SIGNERS_FILE" && "$ALLOWED_SIGNERS_FILE" == "$HOME/.ssh/"* || "$ALLOWED_SIGNERS_FILE" == "$HOME"/* ]]; then
    add_readonly_regular_file "$ALLOWED_SIGNERS_FILE"
else
    [[ -n "$ALLOWED_SIGNERS_FILE" ]] && echo "Warning: allowedSignersFile '$ALLOWED_SIGNERS_FILE' not under \$HOME/.ssh or \$HOME; skipping" >&2
fi

# Forward ssh-agent after .ssh setup so the socket bind remains visible even
# when the agent lives under ~/.ssh.
if [[ -n "${SSH_AUTH_SOCK:-}" && "$SSH_AUTH_SOCK" == /* && -S "$SSH_AUTH_SOCK" ]]; then
    SSH_AUTH_DIR="$(dirname "$SSH_AUTH_SOCK")"
    # Create parent dirs if:
    # 1. SSH_AUTH_DIR is not $HOME (already accessible via other binds)
    # 2. Not the case where (SSH_AUTH_DIR is $HOME/.ssh AND we already created it)
    if [[ "$SSH_AUTH_DIR" != "$HOME" && !( "$SSH_AUTH_DIR" == "$HOME/.ssh" && "$SSH_DOT_DIR_CREATED" -eq 1 ) ]]; then
        # Create parent directories for deep socket paths (e.g. /run/user/UID/keyring).
        # bwrap --dir does not auto-create parents, so we add each component.
        _base=""
        IFS=/ read -ra _parts <<< "$SSH_AUTH_DIR"
        for _p in "${_parts[@]}"; do
            [[ -z "$_p" ]] && continue
            _base="$_base/$_p"
            BWRAP_ARGS+=(--dir "$_base")
        done
        unset _base _parts _p
    fi
    BWRAP_ARGS+=(--bind "$SSH_AUTH_SOCK" "$SSH_AUTH_SOCK")
    BWRAP_ARGS+=(--setenv SSH_AUTH_SOCK "$SSH_AUTH_SOCK")
else
    BWRAP_ARGS+=(--unsetenv SSH_AUTH_SOCK)
fi

# --- Conditional Tool Mounts ---
# Each block guards behind command -v, then checks path existence.

# Bun
if command -v bun >/dev/null 2>&1; then
    [[ -d "$HOME/.bun" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.bun" "$HOME/.bun")
    [[ -d "$HOME/.bun/install/cache" ]] && BWRAP_ARGS+=(--tmpfs "$HOME/.bun/install/cache")
fi

# npm
if command -v npm >/dev/null 2>&1; then
    [[ -d "$HOME/.npm" ]] && BWRAP_ARGS+=(--tmpfs "$HOME/.npm")
    [[ -f "$HOME/.npmrc" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.npmrc" "$HOME/.npmrc")
fi

# pnpm
if command -v pnpm >/dev/null 2>&1; then
    [[ -d "$HOME/.config/pnpm" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.config/pnpm" "$HOME/.config/pnpm")
    [[ -d "$HOME/.local/share/pnpm/store" ]] && BWRAP_ARGS+=(--tmpfs "$HOME/.local/share/pnpm/store")
fi

# uv
if command -v uv >/dev/null 2>&1; then
    [[ -d "$HOME/.config/uv" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.config/uv" "$HOME/.config/uv")
fi

# pipenv (uses ~/.local/share/virtualenvs as centralized store)
if command -v pipenv >/dev/null 2>&1; then
    [[ -d "$HOME/.local/share/virtualenvs" ]] && BWRAP_ARGS+=(--tmpfs "$HOME/.local/share/virtualenvs")
fi

# Rust / Cargo
if command -v cargo >/dev/null 2>&1; then
    [[ -d "$HOME/.rustup" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.rustup" "$HOME/.rustup")
    [[ -d "$HOME/.cargo/bin" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.cargo/bin" "$HOME/.cargo/bin")
    [[ -d "$HOME/.cargo/registry" ]] && BWRAP_ARGS+=(--tmpfs "$HOME/.cargo/registry")
    [[ -f "$HOME/.cargo/config.toml" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.cargo/config.toml" "$HOME/.cargo/config.toml")
fi

# Git config
if command -v git >/dev/null 2>&1 && [[ -f "$HOME/.gitconfig" ]]; then
    BWRAP_ARGS+=(--ro-bind "$HOME/.gitconfig" "$HOME/.gitconfig")
fi

# Mise
mise_installed=false
if command -v mise >/dev/null 2>&1; then
    mise_installed=true
    MISE_CONFIG_DIR="${MISE_CONFIG_DIR:-$HOME/.config/mise}"
    MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
    MISE_CACHE_DIR="${MISE_CACHE_DIR:-$HOME/.cache/mise}"
    for dir in "$MISE_CONFIG_DIR" "$MISE_DATA_DIR" "$MISE_CACHE_DIR"; do
        if [[ -d "$dir" ]]; then
            if is_sensitive_path "$dir"; then
                echo "Warning: MISE directory '$dir' points to or encloses a sensitive location. Skipping bind." >&2
                continue
            fi
            BWRAP_ARGS+=("--ro-bind" "$dir" "$dir")
        fi
    done
fi

# User binds are added first; the isolation overlay binds below come after them
# and therefore win, so the overlay always masks the service registration.
BWRAP_ARGS+=("${EXTRA_BINDS[@]}")
# OpenCode v2 isolation: force a private in-sandbox server for every command.
# Later binds win, so the overlay is appended after EXTRA_BINDS.
ISOLATION_OVERLAY_DIR="$HOME/.local/share/opencodebox"
ISOLATION_OVERLAY_SRC="$ISOLATION_OVERLAY_DIR/disabled-service.json"
ISOLATION_STATE_MASK_SRC="$ISOLATION_OVERLAY_DIR/masked-service-state.json"
mkdir -p "$ISOLATION_OVERLAY_DIR"
write_generated_file "$ISOLATION_OVERLAY_SRC" '{\n  "disabled": true\n}\n' || {
    echo "Error: cannot write '$ISOLATION_OVERLAY_SRC'." >&2
    exit 1
}
# The host background-service registration lives in the state dir, which is
# mounted read-write. Mask it so no sandbox process can learn the host server
# URL/password and drive the host server from inside the sandbox.
write_generated_file "$ISOLATION_STATE_MASK_SRC" '{}\n' || {
    echo "Error: cannot write '$ISOLATION_STATE_MASK_SRC'." >&2
    exit 1
}
for _iso_name in service.json service-local.json service-prod.json; do
    BWRAP_ARGS+=(--ro-bind "$ISOLATION_OVERLAY_SRC" "$CONFIG_DIR/$_iso_name")
done
shopt -s nullglob
for _iso_existing in "$CONFIG_DIR"/service-*.json; do
    case "${_iso_existing##*/}" in
        service-local.json|service-prod.json) ;;
        *) BWRAP_ARGS+=(--ro-bind "$ISOLATION_OVERLAY_SRC" "$_iso_existing") ;;
    esac
done
# Mask the host service registration in the state dir as well.
BWRAP_ARGS+=(--ro-bind "$ISOLATION_STATE_MASK_SRC" "$STATE_DIR/service.json")
for _iso_state_existing in "$STATE_DIR"/service*.json; do
    [[ "${_iso_state_existing##*/}" == "service.json" ]] && continue
    BWRAP_ARGS+=(--ro-bind "$ISOLATION_STATE_MASK_SRC" "$_iso_state_existing")
done
shopt -u nullglob
unset _iso_name _iso_existing _iso_state_existing

# Execute bwrap with all arguments and the target command
# mise activation runs inside sandbox only if host has mise installed
exec bwrap "${BWRAP_ARGS[@]}" -- \
    bash -c '
        if [ "'"$mise_installed"'" = true ]; then
            eval "$(mise activate bash)"
        fi
        exec "'"$OPCODE_SANDBOX_PATH"'" "$@"
    ' -- "$@"
