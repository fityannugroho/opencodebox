VERSION="0.4.3"

print_version() {
    echo "opencode v$(opencode --version)"
    echo "opencodebox v$VERSION"
    exit 0
}

print_help() {
    cat <<EOF
opencodebox - Run OpenCode inside bubblewrap sandbox

Usage:
  opencodebox [OPTIONS] [OPENCODE_ARGS...]

Options:
  --with /host[:/sandbox]      Bind host path read-write (sandbox path defaults to host path)
  --with-ro /host[:/sandbox]   Bind host path read-only (sandbox path defaults to host path)
  --gpu                       Expose host GPU devices and read-only driver metadata
  --persistent-tmp            Keep /tmp in .opencodebox-tmp in the launch directory
  --podman                    Forward the host rootless Podman socket (grants host-user access)
  --version, -v                Show version information
  --help, -h                   Show this help message

Examples:
  opencodebox --gpu --persistent-tmp --podman -s SESSION_ID
  opencodebox --with ../app-backend
  opencodebox --with /mnt/data:/workspace/data
  opencodebox --with-ro /etc/hosts
  opencodebox --with ~/another-project1 --with-ro ~/another-project2 serve
EOF
    exit 0
}

# Helper to check if a path is sensitive (or an ancestor of one)
is_sensitive_path() {
    local path="$1"
    [[ "$path" == "$HOME/.ssh" || "$path" == "$HOME/.ssh/"* || \
       "$path" == "$HOME/.gnupg" || "$path" == "$HOME/.gnupg/"* || \
       "$path" == "$HOME" || "$HOME" == "$path"/* || "$path" == "/" ]]
}

# Prerequisite checks - fail fast with helpful messages
check_prerequisites() {
    local missing=0

    # Check for bwrap (bubblewrap)
    if ! command -v bwrap >/dev/null 2>&1; then
        echo "Error: bubblewrap (bwrap) is not installed." >&2
        echo "" >&2
        echo "Install bubblewrap:" >&2
        echo "  Arch: sudo pacman -S bubblewrap" >&2
        echo "  Ubuntu/Debian: sudo apt install bubblewrap" >&2
        echo "  Fedora: sudo dnf install bubblewrap" >&2
        missing=1
    fi

    # Check for opencode
    if ! command -v opencode >/dev/null 2>&1; then
        echo "Error: opencode is not installed or not in PATH." >&2
        echo "" >&2
        echo "Install opencode:" >&2
        echo "  Using mise: mise use -g opencode" >&2
        echo "  Or download from: https://opencode.ai" >&2
        missing=1
    fi

    if [[ $missing -eq 1 ]]; then
        exit 1
    fi
}

sanitize_ssh_public_key_file() {
    local file="$1"
    local key_fd line extra key_type key_data rest

    command -v ssh-keygen >/dev/null 2>&1 || return 1

    # Open file first to avoid TOCTOU between check and open
    exec {key_fd}<"$file" || return 1

    # Validate the opened FD (not the path) to prevent TOCTOU
    if [[ $(stat -L -c '%F' /proc/self/fd/$key_fd 2>/dev/null) != "regular file" ]]; then
        exec {key_fd}<&-
        return 1
    fi
    if [[ $(stat -L -c '%h' /proc/self/fd/$key_fd 2>/dev/null) -ne 1 ]]; then
        exec {key_fd}<&-
        return 1
    fi

    IFS= read -r line <&"$key_fd" || {
        exec {key_fd}<&-
        return 1
    }
    if IFS= read -r extra <&"$key_fd"; then
        exec {key_fd}<&-
        return 1
    fi

    read -r key_type key_data rest <<< "$line"
    # Accept optional comment in rest; only emit sanitized key_type + key_data
    [[ -n "$key_data" && "$key_data" =~ ^[A-Za-z0-9+/]+={0,2}$ ]] || {
        exec {key_fd}<&-
        return 1
    }

    case "$key_type" in
        ssh-ed25519|ssh-ed25519-cert-v01@openssh.com|ssh-rsa|ssh-rsa-cert-v01@openssh.com|rsa-sha2-256|rsa-sha2-256-cert-v01@openssh.com|rsa-sha2-512|rsa-sha2-512-cert-v01@openssh.com|ecdsa-sha2-nistp256|ecdsa-sha2-nistp256-cert-v01@openssh.com|ecdsa-sha2-nistp384|ecdsa-sha2-nistp384-cert-v01@openssh.com|ecdsa-sha2-nistp521|ecdsa-sha2-nistp521-cert-v01@openssh.com|sk-ssh-ed25519@openssh.com|sk-ssh-ed25519-cert-v01@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com|sk-ecdsa-sha2-nistp256-cert-v01@openssh.com)
            # Validate sanitized key with ssh-keygen; uses process substitution as file input
            ssh-keygen -l -f <(printf '%s %s\n' "$key_type" "$key_data") >/dev/null 2>&1 || {
                exec {key_fd}<&-
                return 1
            }
            exec {key_fd}<&-
            printf '%s %s\n' "$key_type" "$key_data"
            ;;
        *)
            exec {key_fd}<&-
            return 1
            ;;
    esac
}

# BEGIN GPU MOUNTS
# Internal root arguments allow fixture testing without real GPU hardware.
# The launcher always calls this with the host's standard paths. /dev must be
# trusted: type/name checks are not driver authentication or race protection.
configure_gpu_mounts() {
    local dev_root="${1:-/dev}" sys_root="${2:-/sys}"
    local etc_root="${3:-/etc}" proc_root="${4:-/proc}"
    local device relative primary=0 nvidia=0 uvm=0 dri_dir=0 caps_dir=0
    local -a mounts=()

    if [[ -L "$dev_root/dri" || -L "$dev_root/nvidia-caps" ]]; then
        echo "Error: --gpu refuses symlinked GPU device directories." >&2
        return 1
    fi

    for device in "$dev_root"/nvidia[0-9]* \
        "$dev_root"/nvidiactl "$dev_root"/nvidia-uvm \
        "$dev_root"/nvidia-uvm-tools "$dev_root"/nvidia-modeset \
        "$dev_root"/nvidia-caps/nvidia-cap[0-9]* \
        "$dev_root"/dri/card[0-9]* "$dev_root"/dri/renderD[0-9]* \
        "$dev_root"/kfd; do
        relative="${device#"$dev_root/"}"
        # Globs discover candidates; anchored expressions enforce numeric names.
        if [[ ! "$relative" =~ ^nvidia[0-9]+$ &&
              ! "$relative" =~ ^dri/(card[0-9]+|renderD[0-9]+)$ &&
              ! "$relative" =~ ^nvidia-caps/nvidia-cap[0-9]+$ ]]; then
            case "$relative" in
                nvidiactl|nvidia-uvm|nvidia-uvm-tools|nvidia-modeset|kfd) ;;
                *) continue ;;
            esac
        fi
        # stat without -L does not follow symlinks. Fix locale for its type text.
        [[ ! -L "$device" ]] || continue
        [[ "$(LC_ALL=C stat -c '%F' "$device" 2>/dev/null)" == "character special file" ]] || continue

        if [[ "$relative" =~ ^nvidia[0-9]+$ ]]; then
            primary=$((primary + 1))
            nvidia=1
        elif [[ "$relative" =~ ^dri/(card[0-9]+|renderD[0-9]+)$ ]]; then
            primary=$((primary + 1))
        fi
        [[ "$relative" == nvidia-uvm ]] && uvm=1
        if [[ "$relative" == dri/* && "$dri_dir" == 0 ]]; then
            mounts+=(--dir /dev/dri)
            dri_dir=1
        fi
        if [[ "$relative" == nvidia-caps/* && "$caps_dir" == 0 ]]; then
            mounts+=(--dir /dev/nvidia-caps)
            caps_dir=1
        fi
        mounts+=(--dev-bind "$device" "/dev/$relative")
    done

    if [[ "$primary" == 0 ]]; then
        echo "Error: --gpu found no NVIDIA or DRM GPU character devices. Initialize the GPU driver on the host and relaunch opencodebox." >&2
        return 1
    fi

    # Preserve sysfs symlink topology and the host's driver library discovery.
    # /usr (including /usr/share vendor manifests) is already read-only mounted.
    mounts+=(--ro-bind-try "$sys_root" /sys)
    mounts+=(--ro-bind-try "$etc_root/ld.so.cache" /etc/ld.so.cache)
    mounts+=(--ro-bind-try "$etc_root/OpenCL/vendors" /etc/OpenCL/vendors)
    mounts+=(--ro-bind-try "$etc_root/vulkan/icd.d" /etc/vulkan/icd.d)
    mounts+=(--ro-bind-try "$etc_root/glvnd/egl_vendor.d" /etc/glvnd/egl_vendor.d)
    if [[ "$nvidia" == 1 ]]; then
        mounts+=(--ro-bind-try "$proc_root/driver/nvidia" /proc/driver/nvidia)
        if [[ "$uvm" == 0 ]]; then
            echo "Warning: NVIDIA UVM device is absent; CUDA workloads may fail. Initialize the NVIDIA/UVM driver on the host and restart the sandbox." >&2
        fi
    fi
    BWRAP_ARGS+=("${mounts[@]}")
    echo "Warning: --gpu exposes host GPU devices and read-only sysfs; GPU resources and driver access are shared with the host." >&2
}
# END GPU MOUNTS

# Parse --with and --with-ro arguments
# These allow users to bind additional paths into the sandbox
declare -a EXTRA_BINDS=()
declare -a REMAINING_ARGS=()
PODMAN_ENABLED=false
PERSISTENT_TMP_ENABLED=false
GPU_ENABLED=false

add_readonly_regular_file() {
    local file="$1"
    local fd

    # Open first to avoid TOCTOU if file is swapped with symlink after check
    # Use 2>/dev/null to suppress error if file doesn't exist, we handle it below
    if ! { exec {fd}<"$file"; } 2>/dev/null; then
        echo "Warning: Cannot open '$file'. Skipping." >&2
        return 1
    fi

    # Validate the actual file opened by FD, not the path (eliminates TOCTOU)
    if [[ $(stat -L -c '%F' /proc/self/fd/$fd 2>/dev/null) != "regular file" ]]; then
        echo "Warning: '$file' is not a regular file. Skipping." >&2
        exec {fd}<&-
        return 1
    fi
    if [[ $(stat -L -c '%h' /proc/self/fd/$fd 2>/dev/null) -ne 1 ]]; then
        echo "Warning: '$file' has multiple hardlinks. Skipping." >&2
        exec {fd}<&-
        return 1
    fi

    # To prevent TOCTOU attacks where the file is replaced with a symlink
    # between our checks and bwrap execution, we open it now and pass the FD
    BWRAP_ARGS+=(--file "$fd" "$file")
}

parse_bind_arg() {
    local bind_type="$1"
    local val="$2"
    local host sandbox

    if [[ "$val" == *:* ]]; then
        # Format: /host:/sandbox
        host="${val%%:*}"
        sandbox="${val##*:}"
    else
        # Format: /path (same path in sandbox)
        host="$(realpath -e "$val" 2>/dev/null)" || {
            echo "Error: $bind_type path does not exist: $val" >&2
            exit 1
        }
        sandbox="$host"
    fi

    # Reject sensitive paths and their ancestors
    if is_sensitive_path "$host"; then
        echo "Error: Cannot bind sensitive directory '$host' or its ancestor into sandbox." >&2
        exit 1
    fi

    EXTRA_BINDS+=("$bind_type" "$host" "$sandbox")
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            print_help
            ;;
        --version|-v)
            print_version
            ;;
        # --with: read-write bind (allows modification inside sandbox)
        --with)
            shift
            if [[ $# -eq 0 ]]; then
                echo "Error: --with requires a value" >&2
                echo "Usage: opencodebox --with /host/path or --with /host:/sandbox" >&2
                exit 1
            fi
            parse_bind_arg "--bind" "$1"
            shift
            ;;
        # --with-ro: read-only bind (sandbox cannot modify)
        --with-ro)
            shift
            if [[ $# -eq 0 ]]; then
                echo "Error: --with-ro requires a value" >&2
                echo "Usage: opencodebox --with-ro /host/path or --with-ro /host:/sandbox" >&2
                exit 1
            fi
            parse_bind_arg "--ro-bind" "$1"
            shift
            ;;
        --gpu)
            GPU_ENABLED=true
            shift
            ;;
        --persistent-tmp)
            PERSISTENT_TMP_ENABLED=true
            shift
            ;;
        --podman)
            PODMAN_ENABLED=true
            shift
            ;;
        # Pass through all other args to opencode
        *)
            REMAINING_ARGS+=("$1")
            shift
            ;;
    esac
done

check_prerequisites

# Explicit delegation to the host user's rootless container service. Do not
# start services, forward rootful endpoints, or initialize a nested runtime.
PODMAN_SOCKET=""
if [[ "$PODMAN_ENABLED" == true ]]; then
    PODMAN_UID="$(id -u)"
    if [[ "$PODMAN_UID" == 0 ]]; then
        echo "Error: --podman supports only a non-root user's rootless Podman socket." >&2
        exit 1
    fi
    if ! command -v podman >/dev/null 2>&1; then
        echo "Error: --podman requires the podman client installed and available in the sandbox (for example, /usr/bin/podman)." >&2
        exit 1
    fi
    PODMAN_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$PODMAN_UID}"
    if [[ "$PODMAN_RUNTIME_DIR" != /* ]]; then
        echo "Error: --podman requires an absolute XDG_RUNTIME_DIR." >&2
        exit 1
    fi
    PODMAN_SOCKET_PATH="$PODMAN_RUNTIME_DIR/podman/podman.sock"
    if ! PODMAN_SOCKET="$(realpath -e "$PODMAN_SOCKET_PATH" 2>/dev/null)" || [[ ! -S "$PODMAN_SOCKET" ]]; then
        echo "Error: --podman requires a Unix socket at $PODMAN_SOCKET_PATH." >&2
        echo "Start the rootless service outside opencodebox: systemctl --user start podman.socket" >&2
        exit 1
    fi
    if [[ "$(stat -L -c '%u' "$PODMAN_SOCKET" 2>/dev/null)" != "$PODMAN_UID" ]]; then
        echo "Error: --podman socket must be owned by the current user (UID $PODMAN_UID)." >&2
        exit 1
    fi
fi

# Seccomp BPF filter loading
SECCOMP_FD=""
SECCOMP_FILE="$HOME/.local/share/opencodebox/seccomp-security.bpf"

# Detect and map architecture
ARCH=$(uname -m)
case "$ARCH" in
    x86_64)
        SECCOMP_ARCH="x86_64"
        ;;
    aarch64|arm64)
        SECCOMP_ARCH="aarch64"
        ;;
    *)
        SECCOMP_ARCH="unsupported"
        ;;
esac

# Load seccomp filter if arch is supported and file exists
if [[ "$SECCOMP_ARCH" != "unsupported" ]]; then
    # Open file atomically to avoid TOCTOU race condition
    if ! { exec {SECCOMP_FD}< "$SECCOMP_FILE"; } 2>/dev/null; then
        if [[ ! -e "$SECCOMP_FILE" ]]; then
            echo "Warning: Seccomp BPF sandbox filter not found at $SECCOMP_FILE. Continuing without seccomp mitigations." >&2
        else
            echo "Warning: Failed to open seccomp BPF sandbox filter at $SECCOMP_FILE. Continuing without seccomp mitigations." >&2
        fi
        SECCOMP_FD=""
    fi
else
    echo "Warning: Unsupported architecture $ARCH for seccomp sandbox filter. Continuing without seccomp mitigations." >&2
fi

PROJECT_DIR="$PWD"

# Provide minimal NSS identity inside sandbox. Some tools (Git SSH signing,
# ssh-keygen) call getpwuid() and fail if current UID has no /etc/passwd entry.
# FDs intentionally not closed; bwrap reads from them via --file
USER_ID="$(id -u)"
GROUP_ID="$(id -g)"
USER_NAME="$(id -un)"
GROUP_NAME="$(id -gn)"
exec {PASSWD_FD}< <(printf '%s:x:%s:%s:%s:%s:/bin/bash\n' "$USER_NAME" "$USER_ID" "$GROUP_ID" "$USER_NAME" "$HOME")
exec {GROUP_FD}< <(printf '%s:x:%s:\n' "$GROUP_NAME" "$GROUP_ID")

# Restore remaining args for opencode
set -- "${REMAINING_ARGS[@]}"

# Prevent running from sensitive directories (but not for --help/--version which already exited)
if is_sensitive_path "$PROJECT_DIR"; then
    echo "Error: Cannot run from $HOME, sensitive directories, or their ancestors as it bypasses sandbox isolation." >&2
    echo "Please cd into a specific project directory before running." >&2
    exit 1
fi

# Keep the default private tmpfs unless explicitly opted into disk-backed /tmp.
# Use the launch directory, not any project/session argument passed to OpenCode.
# Never chmod, remove, or follow an existing unsafe destination.
declare -a TMP_MOUNT_ARGS=(--tmpfs /tmp)
if [[ "$PERSISTENT_TMP_ENABLED" == true ]]; then
    PERSISTENT_TMP_DIR="$PROJECT_DIR/.opencodebox-tmp"
    if [[ -L "$PERSISTENT_TMP_DIR" ]]; then
        echo "Error: --persistent-tmp refuses symlink '$PERSISTENT_TMP_DIR'." >&2
        exit 1
    fi
    if [[ ! -e "$PERSISTENT_TMP_DIR" ]]; then
        if ! mkdir -m 700 -- "$PERSISTENT_TMP_DIR"; then
            echo "Error: --persistent-tmp cannot create '$PERSISTENT_TMP_DIR'." >&2
            exit 1
        fi
    fi
    if [[ -L "$PERSISTENT_TMP_DIR" || ! -d "$PERSISTENT_TMP_DIR" ]]; then
        echo "Error: --persistent-tmp requires a non-symlink directory at '$PERSISTENT_TMP_DIR'." >&2
        exit 1
    fi
    if [[ "$(stat -c '%u' "$PERSISTENT_TMP_DIR" 2>/dev/null)" != "$USER_ID" ]]; then
        echo "Error: --persistent-tmp directory must be owned by the current user (UID $USER_ID)." >&2
        exit 1
    fi
    if [[ "$(stat -c '%a' "$PERSISTENT_TMP_DIR" 2>/dev/null)" != 700 ]]; then
        echo "Error: --persistent-tmp directory '$PERSISTENT_TMP_DIR' must have permissions 0700. Inspect it and correct its permissions before retrying." >&2
        exit 1
    fi
    TMP_MOUNT_ARGS=(--bind "$PERSISTENT_TMP_DIR" /tmp)
fi

# Define paths for persistent data storage
APP_DATA="$HOME/.local/share/opencode"
CONFIG_DIR="$HOME/.config/opencode"
AGENTS_DIR="$HOME/.agents"
CACHE_DIR="$HOME/.cache/opencode"

# Locate opencode binary
OPCODE_PATH=$(command -v opencode)
OPCODE_DIR=$(dirname "$OPCODE_PATH")

# Later bindings override earlier ones (--with binds come last = highest priority)
declare -a BWRAP_ARGS=(
    # --- Isolation & Namespaces ---
    # Unshare PID/IPC/UTS namespaces for process isolation
    --unshare-pid
    --unshare-ipc
    --unshare-uts
    --die-with-parent    # Sandbox dies if parent process dies

    # --- Core System Resources ---
    --dev /dev           # Device nodes (null, zero, random, etc.)
    --proc /proc         # Process information filesystem
    "${TMP_MOUNT_ARGS[@]}" # Private tmpfs or opt-in persistent project directory

    # --- Read-Only System Root ---
    # Bind entire /usr read-only, symlink standard directories
    --ro-bind /usr /usr
    --symlink usr/lib64 /lib64
    --symlink usr/bin /bin
    --symlink usr/lib /lib

    # --- Sandbox Identity ---
    --hostname opencodebox

    # --- Hostname Resolution ---
    # Keep explicit destinations: resolv.conf may be a symlink on the host.
    --ro-bind /etc/resolv.conf /etc/resolv.conf
    --ro-bind /etc/hosts /etc/hosts
    --ro-bind-try /etc/nsswitch.conf /etc/nsswitch.conf

    # --- SSL/TLS Certificates ---
    # Certificate layouts differ by distribution. Fedora's /etc/ssl links
    # into /etc/pki; expose its trust store without mounting tls/private.
    --ro-bind-try /etc/ssl /etc/ssl
    --ro-bind-try /etc/ca-certificates /etc/ca-certificates
    --ro-bind-try /etc/pki/ca-trust /etc/pki/ca-trust
    --ro-bind-try /etc/pki/tls/certs /etc/pki/tls/certs

    # --- Alternatives (managed by update-alternatives) ---
    --ro-bind /etc/alternatives /etc/alternatives

    # --- Minimal User Identity ---
    --file "$PASSWD_FD" /etc/passwd
    --file "$GROUP_FD" /etc/group

    # --- User Local Data ---
    --ro-bind "$HOME/.local" "$HOME/.local"
    --tmpfs "$HOME/.cache"                   # Writable cache (universal for uv, cargo, etc.)

    # --- OpenCode Specific (read-only) ---
    --ro-bind "$CONFIG_DIR" "$CONFIG_DIR"
    --ro-bind "$AGENTS_DIR" "$AGENTS_DIR"
    --ro-bind "$CACHE_DIR" "$CACHE_DIR"

    # --- Read-Write Bindings ---
    --bind "$PROJECT_DIR" "$PROJECT_DIR"    # Current project (read-write)
    --bind "$APP_DATA" "$APP_DATA"          # OpenCode data (read-write)

    # --- OpenCode Binary ---
    --bind "$OPCODE_DIR" /opt/opencode
)

# Device mounts must follow the private /dev; explicit user binds still come last.
if [[ "$GPU_ENABLED" == true ]]; then
    configure_gpu_mounts || exit 1
fi

# Private keyring (unmount if present)
[[ -d "$HOME/.local/share/keyrings" ]] && BWRAP_ARGS+=(--tmpfs "$HOME/.local/share/keyrings")

# Add seccomp filter to bwrap arguments if available
if [[ -n "$SECCOMP_FD" ]]; then
    BWRAP_ARGS+=(--seccomp "$SECCOMP_FD")
fi

# Reject if .ssh directory has permissive permissions (should be 0700)
# This prevents TOCTOU attacks where .pub files are modified during validation
if [[ -d "$HOME/.ssh" && ! -L "$HOME/.ssh" ]]; then
    if [[ $(stat -c '%a' "$HOME/.ssh" 2>/dev/null) != "700" ]]; then
        echo "Error: $HOME/.ssh permissions must be 0700 to ensure sandbox security." >&2
        echo "Please run: chmod 700 $HOME/.ssh" >&2
        exit 1
    fi
fi

# Git SSH signing often uses user.signingkey=~/.ssh/*.pub. Expose only
# sanitized OpenSSH public key material, not file comments or extra data.
SSH_DOT_DIR_CREATED=0
if [[ -d "$HOME/.ssh" && ! -L "$HOME/.ssh" ]]; then
    BWRAP_ARGS+=(--dir "$HOME/.ssh")
    SSH_DOT_DIR_CREATED=1

    add_readonly_regular_file "$HOME/.ssh/known_hosts"

    shopt -s nullglob
    for pubkey in "$HOME"/.ssh/*.pub; do
        public_key_line="$(sanitize_ssh_public_key_file "$pubkey")" || continue
        exec {pubkey_fd}< <(printf '%s\n' "$public_key_line")
        # FDs intentionally not closed; bwrap reads from them via --file
        BWRAP_ARGS+=(--file "$pubkey_fd" "$pubkey")
    done
    shopt -u nullglob
fi

ALLOWED_SIGNERS_FILE="$(git config --path --get gpg.ssh.allowedSignersFile 2>/dev/null || true)"
if [[ -n "$ALLOWED_SIGNERS_FILE" && "$ALLOWED_SIGNERS_FILE" == "$HOME/.ssh/"* || "$ALLOWED_SIGNERS_FILE" == "$HOME"/* ]]; then
    add_readonly_regular_file "$ALLOWED_SIGNERS_FILE"
else
    [[ -n "$ALLOWED_SIGNERS_FILE" ]] && echo "Warning: allowedSignersFile '$ALLOWED_SIGNERS_FILE' not under \$HOME/.ssh or \$HOME; skipping" >&2
fi

# Forward ssh-agent after .ssh setup so the socket bind remains visible even
# when the agent lives under ~/.ssh.
if [[ -n "${SSH_AUTH_SOCK:-}" && "$SSH_AUTH_SOCK" == /* && -S "$SSH_AUTH_SOCK" ]]; then
    SSH_AUTH_DIR="$(dirname "$SSH_AUTH_SOCK")"
    # Create parent dirs if:
    # 1. SSH_AUTH_DIR is not $HOME (already accessible via other binds)
    # 2. Not the case where (SSH_AUTH_DIR is $HOME/.ssh AND we already created it)
    if [[ "$SSH_AUTH_DIR" != "$HOME" && !( "$SSH_AUTH_DIR" == "$HOME/.ssh" && "$SSH_DOT_DIR_CREATED" -eq 1 ) ]]; then
        # Create parent directories for deep socket paths (e.g. /run/user/UID/keyring).
        # bwrap --dir does not auto-create parents, so we add each component.
        _base=""
        IFS=/ read -ra _parts <<< "$SSH_AUTH_DIR"
        for _p in "${_parts[@]}"; do
            [[ -z "$_p" ]] && continue
            _base="$_base/$_p"
            BWRAP_ARGS+=(--dir "$_base")
        done
        unset _base _parts _p
    fi
    BWRAP_ARGS+=(--bind "$SSH_AUTH_SOCK" "$SSH_AUTH_SOCK")
    BWRAP_ARGS+=(--setenv SSH_AUTH_SOCK "$SSH_AUTH_SOCK")
else
    BWRAP_ARGS+=(--unsetenv SSH_AUTH_SOCK)
fi

# Forward only the opted-in API socket; the host service runs the containers.
# A read-only socket bind would NOT restrict API operations.
if [[ "$PODMAN_ENABLED" == true ]]; then
    BWRAP_ARGS+=(--dir /run --dir /run/opencodebox)
    BWRAP_ARGS+=(--bind "$PODMAN_SOCKET" /run/opencodebox/podman.sock)
    BWRAP_ARGS+=(--unsetenv CONTAINER_CONNECTION)
    BWRAP_ARGS+=(--setenv CONTAINER_HOST unix:///run/opencodebox/podman.sock)
    echo "Warning: --podman grants sandboxed processes access to your host user's Podman service, including host file mounts." >&2
fi

# --- Conditional Tool Mounts ---
# Each block guards behind command -v, then checks path existence.

# Bun
if command -v bun >/dev/null 2>&1; then
    [[ -d "$HOME/.bun" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.bun" "$HOME/.bun")
    [[ -d "$HOME/.bun/install/cache" ]] && BWRAP_ARGS+=(--tmpfs "$HOME/.bun/install/cache")
fi

# npm
if command -v npm >/dev/null 2>&1; then
    [[ -d "$HOME/.npm" ]] && BWRAP_ARGS+=(--tmpfs "$HOME/.npm")
    [[ -f "$HOME/.npmrc" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.npmrc" "$HOME/.npmrc")
fi

# pnpm
if command -v pnpm >/dev/null 2>&1; then
    [[ -d "$HOME/.config/pnpm" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.config/pnpm" "$HOME/.config/pnpm")
    [[ -d "$HOME/.local/share/pnpm/store" ]] && BWRAP_ARGS+=(--tmpfs "$HOME/.local/share/pnpm/store")
fi

# uv
if command -v uv >/dev/null 2>&1; then
    [[ -d "$HOME/.config/uv" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.config/uv" "$HOME/.config/uv")
fi

# pipenv (uses ~/.local/share/virtualenvs as centralized store)
if command -v pipenv >/dev/null 2>&1; then
    [[ -d "$HOME/.local/share/virtualenvs" ]] && BWRAP_ARGS+=(--tmpfs "$HOME/.local/share/virtualenvs")
fi

# Rust / Cargo
if command -v cargo >/dev/null 2>&1; then
    [[ -d "$HOME/.rustup" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.rustup" "$HOME/.rustup")
    [[ -d "$HOME/.cargo/bin" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.cargo/bin" "$HOME/.cargo/bin")
    [[ -d "$HOME/.cargo/registry" ]] && BWRAP_ARGS+=(--tmpfs "$HOME/.cargo/registry")
    [[ -f "$HOME/.cargo/config.toml" ]] && BWRAP_ARGS+=(--ro-bind "$HOME/.cargo/config.toml" "$HOME/.cargo/config.toml")
fi

# Git config
if command -v git >/dev/null 2>&1 && [[ -f "$HOME/.gitconfig" ]]; then
    BWRAP_ARGS+=(--ro-bind "$HOME/.gitconfig" "$HOME/.gitconfig")
fi

# Mise
mise_installed=false
if command -v mise >/dev/null 2>&1; then
    mise_installed=true
    MISE_CONFIG_DIR="${MISE_CONFIG_DIR:-$HOME/.config/mise}"
    MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
    MISE_CACHE_DIR="${MISE_CACHE_DIR:-$HOME/.cache/mise}"
    for dir in "$MISE_CONFIG_DIR" "$MISE_DATA_DIR" "$MISE_CACHE_DIR"; do
        if [[ -d "$dir" ]]; then
            if is_sensitive_path "$dir"; then
                echo "Warning: MISE directory '$dir' points to or encloses a sensitive location. Skipping bind." >&2
                continue
            fi
            BWRAP_ARGS+=("--ro-bind" "$dir" "$dir")
        fi
    done
fi

# Add extra binds from --with/--with-ro last so user choices have highest priority.
BWRAP_ARGS+=("${EXTRA_BINDS[@]}")

# Execute bwrap with all arguments and the target command
# mise activation runs inside sandbox only if host has mise installed
exec bwrap "${BWRAP_ARGS[@]}" -- \
    bash -c '
        if [ "'"$mise_installed"'" = true ]; then
            eval "$(mise activate bash)"
        fi
        exec /opt/opencode/opencode "$@"
    ' -- "$@"
